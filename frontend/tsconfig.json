{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@student/*": ["./student/*"],
      "@admin/*": ["./admin/*"],
      "@lib/*": ["./lib/*"],
      "@supabase/supabase-js": ["../backend/node_modules/@supabase/supabase-js"],
      "@supabase/ssr": ["../backend/node_modules/@supabase/ssr"],
      "lucide-react": ["../backend/node_modules/lucide-react"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
