# ==============================================================================
# SMART STUDENT GRIEVANCE MANAGEMENT SYSTEM - ROOT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to backend/.env.local (and/or backend/.env) to configure the app:
#   cp .env.example backend/.env.local

# Supabase Public Configuration (Exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Server-Only Configuration (CRITICAL: NEVER expose to the browser)
# Used by Next.js Route Handlers for privileged DB operations, admin analytics, and RLS bypass where safe
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google Gemini AI API Configuration
# GEMINI_API_KEY=AIzaSy...
# GEMINI_API_KEY_ID=your-api-key-id
